# Copy to .streamlit/secrets.toml (gitignored) for local cloud mode,
# or paste into Streamlit Community Cloud > App settings > Secrets.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # publishable key only, never the secret/service_role key
APP_TZ = "Australia/Sydney"           # household timezone (IANA name) for "today"

# Required in cloud mode: which login email is which person (case-insensitive).
NICK_EMAIL = "nick@example.com"
NATALIE_EMAIL = "natalie@example.com"
